# ========================================
# SNS Avatar - 환경변수 설정 템플릿
# ========================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요.
# 명령: copy env.example .env

# ========================================
# 파일 경로 설정
# ========================================
# 이미지 파일 감시 폴더 경로
WATCH_FOLDER_PATH=V:\n8n_test

# 캐시 파일 저장 폴더 (선택사항, 기본값: ./cache)
CACHE_FOLDER_PATH=./cache

# 로그 파일 저장 폴더 (선택사항, 기본값: ./logs)
LOG_FOLDER_PATH=./logs

# ========================================
# 텔레그램 설정
# ========================================
# 텔레그램 봇 토큰 (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 텔레그램 채팅 ID (봇과의 대화방 ID)
TELEGRAM_CHAT_ID=your_chat_id_here

# ========================================
# AI 설정
# ========================================
# OpenAI API 키 (GPT 사용)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 모델 (선택사항, 기본값: gpt-4o)
OPENAI_MODEL=gpt-4o

# Gemini API 키 (Google Gemini 사용)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 (선택사항, 기본값: gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-pro

# 사용할 AI 제공자 (openai 또는 gemini, 기본값: openai)
AI_PROVIDER=openai

# AI 최대 재시도 횟수 (선택사항, 기본값: 3)
AI_MAX_RETRIES=3

# ========================================
# 배치 처리 설정
# ========================================
# 배치 수집 대기 시간 (초, 기본값: 10)
BATCH_WAIT_TIME=10

# 최대 배치 크기 (기본값: 10)
MAX_BATCH_SIZE=10

# ========================================
# 파일 안정성 설정
# ========================================
# 파일 복사 완료 대기 시간 (초, 기본값: 5)
FILE_STABILITY_TIMEOUT=5

# ========================================
# SNS 계정 설정 (RPA용)
# ========================================
# 페이스북 로그인 정보
FACEBOOK_EMAIL=your_facebook_email
FACEBOOK_PASSWORD=your_facebook_password

# 인스타그램 로그인 정보
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ========================================
# RPA 브라우저 설정
# ========================================
# 브라우저 헤드리스 모드 (true/false, 기본값: false)
# false 권장 - 탐지 우회 및 디버깅 용이
BROWSER_HEADLESS=false

# 브라우저 데이터 저장 경로 (로그인 세션 유지용)
BROWSER_DATA_DIR=./browser_data

# RPA 동작 간 딜레이 (ms, 기본값: 100)
RPA_SLOW_MO=100

# ========================================
# SNS 계정 설정 (RPA용)
# ========================================
# 페이스북 로그인 정보
FACEBOOK_EMAIL=your_facebook_email
FACEBOOK_PASSWORD=your_facebook_password

# 인스타그램 로그인 정보
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ========================================
# RPA 브라우저 설정
# ========================================
# 브라우저 헤드리스 모드 (true/false, 기본값: false - 화면 표시)
BROWSER_HEADLESS=false

# 브라우저 세션 데이터 저장 폴더 (기본값: ./browser_data)
BROWSER_DATA_DIR=./browser_data

# RPA 동작 간 딜레이 (밀리초, 기본값: 100)
RPA_SLOW_MO=100

# ========================================
# 기타 설정
# ========================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 디버그 모드 (true/false)
DEBUG_MODE=false
